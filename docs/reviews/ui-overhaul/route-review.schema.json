{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SixStringBny/fieldbound/docs/reviews/ui-overhaul/route-review.schema.json",
  "title": "Fieldbound UI overhaul route review record",
  "description": "One record per route under docs/reviews/ui-overhaul/<route>.json. Superset of the docs/reviews/*.json envelope: taskId/reviewer/reviewedAt/decision/evidence keep their existing meaning, and mechanical/human/issues carry the acceptance-bar columns (docs/design-system/acceptance-bar.md §8, §13.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "reviewer",
    "reviewedAt",
    "decision",
    "evidence",
    "route",
    "commit",
    "viewports",
    "mechanical",
    "human",
    "issues"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^UI-[0-9]+-[a-z-]+$",
      "description": "Execution ticket key and route, for example UI-03-battle."
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional digest of the task definition, matching the existing docs/reviews/*.json envelope."
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "description": "The human who signs the human column. Never an agent name."
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "rejected"],
      "description": "The human decision. Must be rejected when any mechanical or human check failed."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "description": "Review note and any committed evidence; screenshot artifacts are named, not committed."
    },
    "route": {
      "type": "string",
      "enum": [
        "menu",
        "how-to-play",
        "settings",
        "solo-setup",
        "run-overview",
        "battle",
        "reward",
        "run-result",
        "duel-setup",
        "privacy",
        "round-result",
        "match-result"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "The commit the checks ran against."
    },
    "viewports": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["375x667", "390x844", "768x1024", "1024x768", "1280x800"]
      },
      "description": "Mechanical viewports. All five targets are required."
    },
    "mechanical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "ranAt", "checks", "summary"],
      "properties": {
        "owner": { "const": "qa-automation-engineer" },
        "ranAt": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mechanicalCheck" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "reviewedAt", "viewports", "checks", "decision"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "viewports": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "contains": { "const": "390x844" },
          "items": {
            "type": "string",
            "enum": ["375x667", "390x844", "768x1024", "1024x768", "1280x800"]
          },
          "allOf": [
            { "contains": { "const": "390x844" } },
            { "contains": { "const": "768x1024" } },
            { "contains": { "const": "1280x800" } }
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/humanCheck" }
        },
        "decision": { "type": "string", "enum": ["approved", "rejected"] }
      }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "mechanicalCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "test", "message"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AB-(C[1-4]|P[1-4]|T[1-4]|G[1-6]|A[1-7]|F[1-5]|V[1-5]|E[1-3])$"
        },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "test": {
          "type": "string",
          "pattern": " › ",
          "description": "Owning file and test title, for example tests/e2e/battle-screen.spec.ts › AB-T3 ..."
        },
        "message": { "type": "string" }
      }
    },
    "humanCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "note"],
      "properties": {
        "id": { "type": "string", "enum": ["H-C1", "H-C2", "H-P1", "H-T1"] },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "note": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "viewport", "measured", "expected", "message"],
      "properties": {
        "check": { "type": "string", "pattern": "^(AB|H)-" },
        "viewport": {
          "type": "string",
          "enum": ["375x667", "390x844", "768x1024", "1024x768", "1280x800"]
        },
        "measured": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
